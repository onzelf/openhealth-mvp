{
  "version": "openhealth-v0.4",
  "ops": {
    "initialise_experiment": {
      "resource": "openhealth-vfp-mvp",
      "action": "initialise_experiment",
      "purpose": "experiment_lifecycle"
    },
    "register_backend": {
      "resource": "openhealth-vfp-mvp",
      "action": "register_backend",
      "purpose": "experiment_lifecycle"
    },
    "start_experiment": {
      "resource": "openhealth-vfp-mvp",
      "action": "start_experiment",
      "purpose": "experiment_lifecycle"
    },
    "join_experiment": {
      "resource": "medmnist-baseline",
      "action": "join_experiment",
      "purpose": "federated_training"
    },
    "train_local": {
      "resource": "medmnist-baseline",
      "action": "train_local",
      "purpose": "federated_training"
    },
    "submit_update": {
      "resource": "medmnist-baseline",
      "action": "submit_update",
      "purpose": "federated_training"
    },
    "evaluate": {
      "resource": "medmnist-baseline",
      "action": "evaluate",
      "purpose": "federated_evaluation"
    }
  },
  "cap_profiles": {
    "capset:openhealth_hub": {
      "cap": [
        "initialise_experiment",
        "register_backend",
        "start_experiment"
      ]
    },
    "capset:openhealth_client": {
      "cap": [
        "join_experiment",
        "train_local",
        "submit_update",
        "evaluate"
      ]
    },
    "capset:openhealth_full": {
      "cap": [
        "initialise_experiment",
        "register_backend",
        "start_experiment",
        "join_experiment",
        "train_local",
        "submit_update",
        "evaluate"
      ]
    }
  },
  "cap_profiles_default": [
    "capset:openhealth_full"
  ],
  "caveats": {
    "audience": "svc:openhealth-vfp-local",
    "prohibitions": []
  },
  "meta": {
    "policy_id": "POL-OPENHEALTH-VFP-LOCAL",
    "manifest_id": "gov-manifest-openhealth-v0.4",
    "notes": [
      "Local OpenHealth VFP governance policy adapted from FLICS session admission.",
      "Controls map to the existing OpenHealth hub and Flower client admission actions."
    ]
  }
}
